<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Donut Crush — Products</title>
<style>
:root{--p:#f28aa6;--pl:#fff0f4;--bg:#fffaf7;--text:#432b29;--muted:#927875;--line:#f0e3df;--green:#39a56f;--red:#d9566d}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:Tahoma,Arial,sans-serif}
.sidebar{position:fixed;right:0;top:0;bottom:0;width:235px;background:#fff;border-left:1px solid var(--line);padding:24px 15px}
.logo{display:flex;gap:10px;align-items:center;padding:5px 8px 32px}.logoIcon{width:44px;height:44px;border-radius:14px;background:linear-gradient(135deg,#ffb6c9,#ef7295);display:grid;place-items:center;font-size:23px}.logo h1{font-size:18px;margin:0}.logo small{color:var(--muted);font-size:10px}
.label{font-size:10px;color:#b29c97;margin:0 10px 9px}.nav a{display:block;text-decoration:none;color:#705c58;padding:12px;border-radius:12px;font-size:12px}.nav a.active{background:var(--pl);color:#dc5c7c;font-weight:bold}
main{margin-right:235px;padding:26px 30px}.head{display:flex;justify-content:space-between;align-items:center;margin-bottom:25px}.head h2{margin:0;font-size:25px}.head p{margin:6px 0 0;color:var(--muted);font-size:11px}
.admin{display:flex;align-items:center;gap:8px;background:#fff;border:1px solid var(--line);padding:7px 11px;border-radius:13px;font-size:11px}.avatar{width:33px;height:33px;border-radius:10px;background:var(--pl);display:grid;place-items:center}
.tools{display:flex;align-items:center;gap:12px;margin-bottom:18px}.selectTools{display:flex;align-items:center;gap:8px}.selectAll{height:42px;padding:0 13px;border:1px solid var(--line);background:#fff;color:#705c58;border-radius:12px;font-size:11px;font-weight:bold}.bulkDelete{height:42px;padding:0 13px;border:0;background:#ffe9ec;color:var(--red);border-radius:12px;font-size:11px;font-weight:bold;display:none}.bulkDelete.show{display:block}.check{position:absolute;top:10px;left:10px;width:20px;height:20px;accent-color:#ef7295;cursor:pointer;z-index:2}.card.selected{border:2px solid var(--p);box-shadow:0 10px 30px #f28aa622}.search{height:42px;width:290px;border:1px solid var(--line);border-radius:12px;padding:0 14px;outline:0;background:#fff}.count{font-size:11px;color:var(--muted);margin-left:auto}.add{height:42px;padding:0 17px;background:var(--p);color:#fff;border-radius:12px;font-size:12px;font-weight:bold;box-shadow:0 8px 20px #f28aa633}
.products{display:grid;grid-template-columns:repeat(4,1fr);gap:17px}.card{background:#fff;border:1px solid var(--line);border-radius:18px;overflow:hidden;box-shadow:0 10px 30px #5a322b0b;transition:.2s}.card:hover{transform:translateY(-3px)}
.pic{height:175px;background:linear-gradient(135deg,#ffe1e9,#fff0df);display:grid;place-items:center;position:relative}.pic img{width:100%;height:100%;object-fit:cover}.emoji{font-size:62px}.tag{position:absolute;top:10px;right:10px;padding:6px 9px;border-radius:20px;font-size:9px;font-weight:bold;background:#e7f8ef;color:#27845b}.tag.off{background:#ffe9ec;color:#c54e62}
.info{padding:14px}.info h3{font-size:14px;margin:0}.info p{font-size:10px;color:var(--muted);height:32px;line-height:1.6;margin:6px 0}.row{display:flex;justify-content:space-between;align-items:center}.price{font-weight:bold;color:#df5e80;font-size:14px}.buttons{display:flex;gap:5px}.btn{border:0;padding:7px 8px;border-radius:9px;font-size:9px;background:#fff2f5;color:#d65d7b}.btn.gray{background:#f4efed;color:#806e69}.btn.red{background:#ffedf0;color:var(--red)}
.empty{display:none;text-align:center;background:#fff;border:1px dashed #e9d5d0;border-radius:18px;padding:55px;color:var(--muted)}
.modal{position:fixed;inset:0;background:#2e1c1b88;display:none;align-items:center;justify-content:center;padding:18px;z-index:5}.modal.show{display:flex}.box{width:min(470px,100%);background:#fff;border-radius:20px;padding:22px}.modalHead{display:flex;justify-content:space-between;align-items:center;margin-bottom:17px}.modalHead h3{margin:0;font-size:17px}.close{width:34px;height:34px;border:0;border-radius:10px;background:#f7eeee}.field{margin-bottom:11px}.field label{display:block;font-size:10px;color:#806d68;margin-bottom:6px}.field input,.field textarea{width:100%;border:1px solid var(--line);border-radius:11px;padding:10px;outline:0}.field textarea{height:70px;resize:none}.formBtns{display:flex;gap:8px;margin-top:5px}.save,.cancel{border:0;padding:11px 17px;border-radius:11px;font-size:11px;font-weight:bold}.save{background:var(--p);color:#fff}.cancel{background:#f4efed;color:#705c58}
.toast{position:fixed;bottom:20px;left:20px;background:var(--text);color:#fff;padding:12px 16px;border-radius:11px;font-size:11px;opacity:0;transform:translateY(10px);transition:.2s}.toast.show{opacity:1;transform:none}
@media(max-width:1050px){.products{grid-template-columns:repeat(3,1fr)}}@media(max-width:800px){.sidebar{display:none}main{margin:0;padding:18px}.head h2{font-size:21px}.admin{display:none}.tools{flex-wrap:wrap}.search{width:100%;order:2}.count{margin:0}.add{width:100%}.products{grid-template-columns:repeat(2,1fr)}}@media(max-width:500px){.products{grid-template-columns:1fr}.pic{height:190px}}
</style>
</head>
<body>
<aside class="sidebar">
<div class="logo"><div class="logoIcon">🍩</div><div><h1>Donut Crush</h1><small>إدارة المنتجات</small></div></div>
<div class="label">لوحة الإدارة</div><nav class="nav"><a class="active">🍩 &nbsp; المنتجات</a></nav>
</aside>
<main>
<header class="head"><div><h2>إدارة المنتجات</h2><p>إضافة وتعديل وإخفاء منتجات Donut Crush</p></div><div class="admin"><div class="avatar">👤</div>Admin</div></header>
<div class="tools"><input id="search" class="search" placeholder="🔎  ابحث عن منتج..."><span id="count" class="count"></span><div class="selectTools"><button id="selectAll" class="selectAll" onclick="selectAllVisible()">☑ تحديد الكل</button><button id="bulkDelete" class="bulkDelete" onclick="deleteSelected()">🗑 حذف المحدد (<span id="selectedCount">0</span>)</button></div><button class="add" onclick="addProduct()">＋ إضافة منتج</button></div>
<div id="products" class="products"></div><div id="empty" class="empty">🍩<br><br>لا يوجد منتج مطابق للبحث</div>
</main>
<div id="modal" class="modal"><div class="box">
<div class="modalHead"><h3 id="title">إضافة منتج</h3><button class="close" onclick="closeModal()">✕</button></div>
<form id="form">
<div class="field"><label>اسم المنتج</label><input id="name" required placeholder="Chocolate Crush"></div>
<div class="field"><label>الوصف</label><textarea id="desc" placeholder="وصف المنتج"></textarea></div>
<div class="field"><label>السعر بالجنيه</label><input id="price" type="number" min="0" required placeholder="55"></div>
<div class="field"><label>صورة المنتج</label><input id="imageFile" type="file" accept="image/*"></div>
<div class="formBtns"><button class="save">حفظ</button><button type="button" class="cancel" onclick="closeModal()">إلغاء</button></div>
</form></div></div>
<div id="toast" class="toast"></div>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
const SUPABASE_URL="https://euvcfvsejcsoympamjub.supabase.co";
const SUPABASE_KEY="sb_publishable_hct8gjRVMCj2L59vI46Yag_VuXReOdU";
const db=window.supabase.createClient(SUPABASE_URL,SUPABASE_KEY);
let edit=-1;
let data=[];
let selected=new Set();
const esc=x=>String(x??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","\'":"&#039;"}[m]));
async function loadProducts(){const {data:rows,error}=await db.from("Products").select("id,name,description,price,image,available,created_at").order("created_at",{ascending:false});if(error){console.error(error);toast("تعذر تحميل المنتجات");return}data=(rows||[]).map(p=>({id:p.id,name:p.name||"",desc:p.description||"",price:Number(p.price||0),image:p.image||"",on:p.available!==false,e:"🍩"}));render()}
function render(){let q=document.getElementById("search").value.toLowerCase().trim();let list=data.map((p,i)=>({p,i})).filter(x=>x.p.name.toLowerCase().includes(q)||x.p.desc.toLowerCase().includes(q));document.getElementById("count").textContent=data.length+" منتجات";
let visibleIds=list.map(x=>x.p.id);
let allSelected=visibleIds.length>0&&visibleIds.every(id=>selected.has(id));
document.getElementById("selectAll").textContent=allSelected?"☐ إلغاء تحديد الكل":"☑ تحديد الكل";
document.getElementById("selectedCount").textContent=selected.size;
document.getElementById("bulkDelete").classList.toggle("show",selected.size>0);document.getElementById("empty").style.display=list.length?"none":"block";document.getElementById("products").style.display=list.length?"grid":"none";document.getElementById("products").innerHTML=list.map(x=>{let p=x.p,i=x.i;return `<article class="card ${selected.has(p.id)?"selected":""}"><div class="pic"><input class="check" type="checkbox" ${selected.has(p.id)?"checked":""} onchange="selectProduct('${p.id}',this.checked)">${p.image?`<img src="${esc(p.image)}" onerror="this.style.display='none'">`:`<span class="emoji">${p.e}</span>`}<span class="tag ${p.on?"":"off"}">${p.on?"متاح":"غير متاح"}</span></div><div class="info"><h3>${esc(p.name)}</h3><p>${esc(p.desc)}</p><div class="row"><span class="price">${p.price} ج.م</span><div class="buttons"><button class="btn" onclick="editProduct(${i})">✏ تعديل</button><button class="btn gray" onclick="toggle(${i})">${p.on?"إخفاء":"إظهار"}</button><button class="btn red" onclick="del(${i})">🗑</button></div></div></div></article>`}).join("")}
function addProduct(){edit=-1;document.getElementById("title").textContent="إضافة منتج";document.getElementById("form").reset();document.getElementById("modal").classList.add("show")}
function editProduct(i){edit=i;let p=data[i];document.getElementById("title").textContent="تعديل المنتج";document.getElementById("name").value=p.name;document.getElementById("desc").value=p.desc;document.getElementById("price").value=p.price;document.getElementById("imageFile").value="";document.getElementById("modal").classList.add("show")}
function closeModal(){document.getElementById("modal").classList.remove("show")}
function readImage(file){return new Promise((resolve,reject)=>{let r=new FileReader();r.onload=()=>resolve(r.result);r.onerror=reject;r.readAsDataURL(file)})}
document.getElementById("form").onsubmit=async e=>{e.preventDefault();let file=document.getElementById("imageFile").files[0],old=edit>=0?data[edit]:null,image=old?.image||"";if(file)image=await readImage(file);let productName=document.getElementById("name").value.trim();let productDesc=document.getElementById("desc").value.trim();let productPrice=Number(document.getElementById("price").value);let payload={name:productName,description:productDesc,price:productPrice,image,available:old?old.on:true};if(!payload.name||!Number.isFinite(payload.price)||payload.price<0){toast("راجع بيانات المنتج");return}let result=edit<0?await db.from("Products").insert(payload).select().single():await db.from("Products").update(payload).eq("id",old.id).select().single();if(result.error){console.error(result.error);toast("فشل الحفظ: "+result.error.message);return}closeModal();toast(edit<0?"تمت إضافة المنتج وحفظه":"تم تعديل المنتج وحفظه");await loadProducts()}
async function toggle(i){let p=data[i],next=!p.on,{error}=await db.from("Products").update({available:next}).eq("id",p.id);if(error){toast("فشل تغيير حالة المنتج");return}p.on=next;render();toast(next?"تم إظهار المنتج":"تم إخفاء المنتج")}
async function del(i){let p=data[i];if(!p?.id){toast("تعذر تحديد المنتج");return}if(!confirm("هل تريد حذف هذا المنتج؟"))return;let {error}=await db.from("Products").delete().eq("id",p.id);if(error){console.error(error);toast("فشل حذف المنتج: "+error.message);return}selected.delete(p.id);data=data.filter(x=>x.id!==p.id);render();toast("تم حذف المنتج")}

function selectProduct(id,checked){if(checked)selected.add(id);else selected.delete(id);render()}
function selectAllVisible(){let q=document.getElementById("search").value.toLowerCase().trim();let visible=data.filter(p=>p.name.toLowerCase().includes(q)||p.desc.toLowerCase().includes(q)).map(p=>p.id);let all=visible.length>0&&visible.every(id=>selected.has(id));visible.forEach(id=>all?selected.delete(id):selected.add(id));render()}
async function deleteSelected(){let ids=[...selected];if(!ids.length)return;if(!confirm(`هل تريد حذف ${ids.length} منتج؟`))return;let {error}=await db.from("Products").delete().in("id",ids);if(error){console.error(error);toast("فشل حذف المنتجات: "+error.message);return}selected.clear();toast("تم حذف المنتجات المحددة");await loadProducts()}
function toast(t){let x=document.getElementById("toast");x.textContent=t;x.classList.add("show");clearTimeout(window.tt);window.tt=setTimeout(()=>x.classList.remove("show"),2200)}
document.getElementById("search").oninput=render;loadProducts();
</script>
</body>
</html>
